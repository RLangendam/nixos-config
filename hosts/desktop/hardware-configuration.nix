{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "ahci"
    "usb_storage"
    "usbhid"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  # boot.extraModulePackages = [ "xone" ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/d759191d-efbb-455e-b20e-bcae3683d35a";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/4AFF-3A39";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  fileSystems."/data" = {
    device = "/dev/disk/by-uuid/bb685c32-754c-4e61-a213-8cebb543d895";
    fsType = "xfs";
    options = [
      "defaults"
      "nofail"
      "user"
      "exec"
    ];
  };

  fileSystems."/home/ralph/.var/app/moe.launcher.an-anime-game-launcher/data/anime-game-launcher/Genshin Impact" =
    {
      depends = [
        "/data"
      ];
      device = "/data/AAGL/Genshin Impact/";
      fsType = "none";
      options = [
        "bind"
        "defaults"
        "nofail"
        "user"
        "exec"
      ];
    };

  fileSystems."/home/ramon/.var/app/moe.launcher.an-anime-game-launcher/data/anime-game-launcher/Genshin Impact" =
    {
      depends = [
        "/data"
      ];
      device = "/data/AAGL/Genshin Impact/";
      fsType = "none";
      options = [
        "bind"
        "defaults"
        "nofail"
        "user"
        "exec"
      ];
    };

  swapDevices = [
    { device = "/dev/disk/by-uuid/e226e865-e358-4581-beb7-2fdb664b0fd6"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
  hardware.bluetooth.enable = true;
  hardware.xone.enable = true;

  boot.supportedFilesystems = [
    "exfat" # For larger USBs
    "ntfs" # For Windows formatted drives
    "vfat" # For FAT32
  ];

  hardware.printers = {
    ensurePrinters = [
      {
        name = "HP_Laserjet_4050TN";
        location = "Home Office";
        description = "Network Laser Printer";
        
        deviceUri = "socket://192.168.2.100";
        
        # model = "drv:///sample.drv/generic.ppd";
        model = "gutenprint.5.3://hp-lj_4000/expert";
        
        ppdOptions = {
          PageSize = "A4";
          Option1 = "True";
        };
      }
    ];
    
    ensureDefaultPrinter = "HP_Laserjet_4050TN";
  };
}
